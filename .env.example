# Supabase project this app syncs to. Both values are safe in a client bundle: the URL identifies the
# project and the anon key only says "an anonymous visitor of this project" - what actually grants
# access is row-level security (see supabase/schema.sql).
#
# NEVER put the service_role key here, or in any other VITE_ variable: everything prefixed VITE_ is
# compiled into the JavaScript every visitor downloads.
#
# Leave both unset (or delete this file's copy) to run the app entirely locally - that is a supported
# mode, not a degraded one: nothing syncs, everything still works.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=